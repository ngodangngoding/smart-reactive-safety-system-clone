# Demo build: no database, no Redis, no provisioning needed. Everything runs from an
# in-memory store seeded at startup (see src/lib/prisma.js). Copy this file to .env.local
# if you want to override any of these; the defaults below already work out of the box.

# Auth (fixed demo value below works out of the box; change it for anything but a demo)
JWT_SECRET=demo-jwt-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Google sign-in (leave empty to disable POST /api/auth/google)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# License start/end dates are calendar dates evaluated in this IANA time zone
BUSINESS_TIME_ZONE=Asia/Jakarta

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Forgot-password OTP
OTP_EXPIRY_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_SECONDS=900

# Mail: "log" prints the OTP to the server console (demo default), "smtp" sends real email
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Lone Worker Safety <no-reply@example.com>"

# IoT telemetry webhook (fixed demo value below works out of the box)
TELEMETRY_WEBHOOK_SECRET=demo-webhook-secret-change-me
TELEMETRY_WEBHOOK_MAX_BATCH=500
TELEMETRY_DEDUPE_TTL_SECONDS=3600
